#!/bin/sh
set -eu
if [ "$1" = configure ]; then
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/dailycalendar.conf
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    # Respect an existing user's explicit disable choice during upgrades.
    state=$(systemctl is-enabled dailycalendar-update.timer 2>/dev/null || true)
    if [ "$state" = masked ] || [ "$state" = masked-runtime ]; then
      :
    elif [ -z "${2:-}" ]; then
      systemctl enable --now dailycalendar-update.timer
    elif [ "$state" = enabled ]; then
      # Also starts a timer that prerm stopped before a reinstall; a plain
      # try-restart would leave it inactive. A disabled timer stays off.
      systemctl restart dailycalendar-update.timer
    fi
  fi
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
  fi
fi
