    "Interprets a captured Signal phrase as one of Daily's supported calendar actions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interprets a captured Signal phrase as one of Daily's supported calendar actions."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아 적은 시그널 문구를 Daily가 지원하는 캘린더 동작으로 해석합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞き取ったSignalのフレーズを、Dailyが対応するカレンダー操作として解釈します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將擷取到的 Signal 語句解讀為 Daily 支援的行事曆操作。"
          }
        }
      }
    },
